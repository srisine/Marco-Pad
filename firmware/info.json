{
    "keyboard_name": "Shaw Macropad",
    "url": "",
    "maintainer": "ItsShawww",
    "width": 4,
    "height": 2,
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": false,
        "nkro": true,
        "oled": true,
        "encoder": true
    },
    "matrix_pins": {
        "direct": [
            ["GP2", "GP1", "GP10", "GP3"]
        ]
    },
    "encoder": {
        "rotary": [
            { "pin_a": "GP4", "pin_b": "GP5" }
        ]
    },
    "oled": {
        "driver": "ssd1306"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "K1", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "K2", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "K3", "matrix": [0, 2], "x": 2, "y": 0},
                {"label": "K4", "matrix": [0, 3], "x": 3, "y": 0},
                {"label": "ENC", "matrix": [0, 4], "x": 4, "y": 0}
            ]
        }
    }
}